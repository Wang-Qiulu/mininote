{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小记事本",
  "version": "0.1.0",
  "identifier": "com.wangqiulu.mininote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "小记事本",
        "width": 360,
        "height": 300,
        "minWidth": 320,
        "minHeight": 220,
        "maxWidth": 1200,
        "maxHeight": 900,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true,
        "focus": true,
        "windowEffects": {
          "effects": ["liquidGlassRegular"],
          "state": "followsWindowActiveState",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "本地运行的浮窗速记应用",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
